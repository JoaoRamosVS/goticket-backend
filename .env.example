# ── Banco de dados (Postgres do docker-compose: usuário/senha 'goticket', porta 5433) ──
DB_URL=jdbc:postgresql://localhost:5433/GoTicketDB
DB_USER=goticket
DB_PASSWORD=goticket

# ── Redis (docker-compose) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AWS S3 / LocalStack ──
BUCKET_NAME=goticket-dev
AWS_REGION=us-east-1

# ── Stripe (MODO TESTE) — obtenha as suas em https://dashboard.stripe.com/test/apikeys ──
# a app sobe com placeholders, porém os fluxos de pagamento real precisam de chaves reais
STRIPE_SECRET_KEY=sk_test_••••••••••••••••••••••••
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xx••••••••••••••••••••••